{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Conversation Crystal",
  "type": "object",
  "required": [
    "id",
    "created_at",
    "status",
    "invariants",
    "facets",
    "provenance",
    "open_frontiers"
  ],
  "properties": {
    "id": {
      "type": "string"
    },
    "parent_ids": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "created_at": {
      "type": "string"
    },
    "status": {
      "enum": [
        "observed",
        "derived",
        "proposed",
        "hypothesis",
        "human-verified",
        "superseded"
      ]
    },
    "orientation": {
      "type": "object",
      "additionalProperties": true
    },
    "invariants": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "facets": {
      "type": "object",
      "additionalProperties": true
    },
    "relations": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": true
      }
    },
    "delta_s": {
      "type": "object",
      "additionalProperties": true
    },
    "residue": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "disagreements": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": true
      }
    },
    "provenance": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "kind",
          "locator"
        ],
        "properties": {
          "kind": {
            "type": "string"
          },
          "locator": {
            "type": "string"
          },
          "note": {
            "type": "string"
          }
        },
        "additionalProperties": true
      }
    },
    "open_frontiers": {
      "type": "array",
      "items": {
        "type": "string"
      }
    }
  },
  "additionalProperties": true
}
